# Postgres connection string (Vercel dashboard → Storage → Postgres).
POSTGRES_URL=postgres://user:password@host:5432/database
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Vercel Blob storage read/write token (Vercel dashboard → Storage → Blob).
# Required for the `media` collection uploads and for running the seed locally.
BLOB_READ_WRITE_TOKEN=
# Canonical origin used for canonicals, sitemap and JSON-LD. Set this on
# preview/branch deployments so they don't emit production URLs.
NEXT_PUBLIC_SITE_URL=https://sistemgranit.com
